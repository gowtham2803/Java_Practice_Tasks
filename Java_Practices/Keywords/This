## Problem 1 – Mobile (Constructor Overloading)

class Mobile {

    String brand;
    int price;

    Mobile() {
        brand = "Samsung";
        price = 20000;
    }

    Mobile(String brand) {
        this.brand = brand;
        this.price = 25000;
    }

    Mobile(String brand, int price) {
        this.brand = brand;
        this.price = price;
    }

    void display() {
        System.out.println("Brand : " + brand);
        System.out.println("Price : " + price);
        System.out.println();
    }

    public static void main(String[] args) {

        Mobile m1 = new Mobile();
        Mobile m2 = new Mobile("Nokia");
        Mobile m3 = new Mobile("Apple", 85000);

        m1.display();
        m2.display();
        m3.display();
    }
}
```

