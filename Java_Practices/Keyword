Exsercise 4:
class Calculator {

    int a = 10;
    static int b = 20;

    void instanceMethod() {
        System.out.println(a);
        System.out.println(b);
        staticMethod();
    }

    static void staticMethod() {
        System.out.println(b);   // ✅
    }
    public static void main(String[] args) {
        Calculator c = new Calculator();
        c.instanceMethod();
        Calculator.staticMethod();
    }
}

