Exsercise 1 :
class Employee {
    String name;
    static String company = "OpenAI";

    Employee(String name){
        this.name = name;
    }

    void display(){
        System.out.printf("name : %s | company : %s%n",name,company);
    }
    public static void main(String[] args) {
        Employee e1 = new Employee("Gowtham");
        Employee e2 = new Employee("Stark");

        e1.display();
        e2.display();
    }
}

Exsercise 2 :
class Student {
    String name;
    static String college = "SLA";

    Student(String name){
        this.name = name;
    }

    void display(){
        System.out.printf("name : %s | College : %s%n",name,college);
    }
    public static void main(String[] args) {
        Student s1 = new Student("Gowtham");
        Student s2 = new Student("Stark");

        s1.display();
        s2.display();

        Student.college = "IIT";
        System.out.println("----------After Changing------------");

        s1.display();
        s2.display();
    }
}

